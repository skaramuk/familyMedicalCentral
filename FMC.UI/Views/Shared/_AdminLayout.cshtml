<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <meta name="copyright" content="MACode ID, https://macodeid.com/">

    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="~/assets/css/maicons.css">

    <link rel="stylesheet" href="~/assets/css/bootstrap.css">

    <link rel="stylesheet" href="~/assets/vendor/owl-carousel/css/owl.carousel.css">

    <link rel="stylesheet" href="~/assets/vendor/animate/animate.css">

    <link rel="stylesheet" href="~/assets/css/theme.css">
</head>
<header>
    <div class="topbar">
        <div class="container">
            <div class="row">
                <div class="col-sm-8 text-sm">
                    <div class="site-info">
                        <a href="#"><span class="mai-call text-primary"></span> +00 123 4455 6666</a>
                        <span class="divider">|</span>
                        <a href="#"><span class="mai-mail text-primary"></span> info@fmc.com</a>
                    </div>
                </div>
                <div class="col-sm-4 text-right text-sm">
                    <div class="social-mini-button">
                        <a href="#" id="link"><span class="mai-logo-facebook-f"></span></a>
                        <a href="#" id="link"><span class="mai-logo-twitter"></span></a>
                        <a href="#" id="link"><span class="mai-logo-dribbble"></span></a>
                        <a href="#" id="link"><span class="mai-logo-instagram"></span></a>
                    </div>
                </div>
            </div> <!-- .row -->
        </div> <!-- .container -->
    </div> <!-- .topbar -->

    <nav class="navbar navbar-expand-lg navbar-light shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="#"><img src="~/assets/img/icon.png" style="width:90px; height:90px;" /></a>

            @*<form action="#">
                    <div class="input-group input-navbar">
                        <div class="input-group-prepend">
                            <span class="input-group-text" id="icon-addon1"><span class="mai-search"></span></span>
                        </div>
                        <input type="text" class="form-control" placeholder="Enter keyword.." aria-label="Username" aria-describedby="icon-addon1">
                    </div>
                </form>*@

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupport" aria-controls="navbarSupport" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupport">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item active">
                        <a class="nav-link" href="/Default/Index">Anasayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Default/About">Hakkımızda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Default/Doctors">Doktorlar</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Default/News">Haberler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Default/Contact">İletişim</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary ml-lg-3" href="/Register/Register">Giriş / Kayıt</a>
                    </li>
                </ul>
            </div> <!-- .navbar-collapse -->
        </div> <!-- .container -->
    </nav>
</header>
<div>
    @RenderBody()
</div>
<div>
    <div class="page-section banner-home bg-image" style="background-image: url(~/assets/img/banner-pattern.svg);">
        <div class="container py-5 py-lg-0">
            <div class="row align-items-center">
                <div class="col-lg-4 wow zoomIn">
                    <div class="img-banner d-none d-lg-block">
                        <img src="~/assets/img/mobile_app.png" alt="">
                    </div>
                </div>
                <div class="col-lg-8 wow fadeInRight">
                    <h1 class="font-weight-normal mb-3">FMC Mobil Uygulamasını kullanarak tüm özelliklere anında erişim sağlayın</h1>
                    <a href="#"><img src="~/assets/img/google_play.svg" alt=""></a>
                    <a href="#" class="ml-2"><img src="~/assets/img/app_store.svg" alt=""></a>
                </div>
            </div>
        </div>
    </div> <!-- .banner-home -->

    <footer class="page-footer">
        <div class="container">
            <div class="row px-md-3">
                <div class="col-sm-6 col-lg-3 py-3">
                    <h5>Şirket</h5>
                    <ul class="footer-menu">
                        <li><a href="#">Hakkımızda</a></li>
                    </ul>
                </div>
                <div class="col-sm-6 col-lg-3 py-3">
                    <h5>İletişim</h5>
                    <p class="footer-link mt-2">Sultanlı,12, 25600, Hinis/İstanbul, Türkiye</p>
                    <a href="#" class="footer-link">523-573-7582</a>
                    <a href="#" class="footer-link">info@fmc.com</a>

                    <h5 class="mt-3">Sosyal Medya</h5>
                    <div class="footer-sosmed mt-3">
                        <a href="#" id="link"><span class="mai-logo-facebook-f"></span></a>
                        <a href="#" id="link"><span class="mai-logo-twitter"></span></a>
                        <a href="#" id="link"><span class="mai-logo-google-plus-g"></span></a>
                        <a href="#" id="link"><span class="mai-logo-instagram"></span></a>
                        <a href="#" id="link"><span class="mai-logo-linkedin"></span></a>
                    </div>
                </div>
            </div>

            <hr>

            <p id="copyright">Copyright &copy; @DateTime.Now.Year Dizayn:<a href="https://yusufpalak.github.io/" target="_blank">Yusuf Palak</a>. Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="~/assets/js/jquery-3.5.1.min.js"></script>

    <script src="~/assets/js/bootstrap.bundle.min.js"></script>

    <script src="~/assets/vendor/owl-carousel/js/owl.carousel.min.js"></script>

    <script src="~/assets/vendor/wow/wow.min.js"></script>

    <script src="~/assets/js/theme.js"></script>
    <script>
        $(document).on("click", "#link", function () {
            alert("Görünüşe göre bu linkte hiçbir şey yok.");
        });
    </script>
</div>
